# GitHub Personal Access Token (Private repoları okumak ve batch-canary doğrulama + main merge için)
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Komut merkezinde GitHub ile giriş yapmasına izin verilen yönetici GitHub kullanıcı adı
GITHUB_OWNER=your-github-username

# GitHub kullanmayan veya doğrudan şifreyle giriş yapmak isteyen kurulumlar için yönetici şifresi
GUARDIAN_ADMIN_PASSWORD=change_this_admin_password

# Vercel Cron (/api/cron/scan) güvenlik anahtarı (isteğe bağlı)
CRON_SECRET=change_this_cron_secret
